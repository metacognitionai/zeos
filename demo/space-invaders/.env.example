# Copy to .env and fill in. The agent CLI reads this file automatically;
# any flag you pass on the command line still wins over it.
# The variable names are the two SDKs' own, so an environment already set up
# for either of them works with no changes.

# --- any endpoint serving the OpenAI Responses API: `agent --player openai` ---
# vLLM, SGLang, Ollama, LM Studio, or a hosted provider. Leave the base URL
# empty for OpenAI's own endpoint.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
# The README's tables were measured with `qwen/qwen3.6-35b-a3b` served by
# LM Studio; `qwen/qwen3-4b` is the small-model row. Use the id your server lists.
OPENAI_MODEL=Qwen/Qwen3-4B

# --- the Claude API: `agent --player claude` ---------------------------------
# Leave the base URL empty for the official endpoint. Note that a Claude Code
# session exports ANTHROPIC_BASE_URL; a run started inside one will follow it,
# and the banner prints the endpoint so you can see that it did.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
